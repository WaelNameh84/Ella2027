COMFYUI_NEGATIVE_PROMPT_NODE=
COMFYUI_NEGATIVE_PROMPT_INPUT=text
COMFYUI_WIDTH_NODE=
COMFYUI_WIDTH_INPUT=width
COMFYUI_HEIGHT_NODE=
COMFYUI_HEIGHT_INPUT=height
COMFYUI_FRAMES_NODE=
COMFYUI_FRAMES_INPUT=length
COMFYUI_FPS_NODE=
COMFYUI_FPS_INPUT=fps
COMFYUI_SEED_NODE=
COMFYUI_SEED_INPUT=seed
