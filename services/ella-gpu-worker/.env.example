ELLA_WORKER_TOKEN=replace-with-a-long-random-secret
WORKER_DATA_DIR=/data
COMFYUI_BASE_URL=http://comfyui:8188
COMFYUI_WORKFLOW_PATH=/app/workflows/video_api.json
COMFYUI_OUTPUT_DIR=/comfyui/output
