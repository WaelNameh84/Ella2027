# Required. Generate a long random token; use the same value as Ella's provider API key.
WORKER_API_TOKEN=replace-with-a-long-random-secret
# ComfyUI API base URL reachable from this worker
COMFYUI_URL=http://127.0.0.1:8188
COMFYUI_WORKFLOW=/app/workflows/video_api.json
# Configure the node/input mapping for your exact ComfyUI API workflow export.
COMFYUI_PROMPT_NODE=6
COMFYUI_PROMPT_INPUT=text
COMFYUI_SIZE_NODE=10
COMFYUI_WIDTH_INPUT=width
COMFYUI_HEIGHT_INPUT=height
COMFYUI_DURATION_NODE=12
COMFYUI_FRAMES_INPUT=length
COMFYUI_IMAGE_NODE=20
COMFYUI_IMAGE_INPUT=image
COMFYUI_SEED_NODE=9
COMFYUI_SEED_INPUT=seed
# Must be the node ID that writes a video in ComfyUI history.outputs.
COMFYUI_VIDEO_OUTPUT_NODE=30
ELLA_MODEL_ID=wan2.2-ti2v-5b
ELLA_MODEL_VRAM_GB=8
ELLA_MAX_CLIP_SECONDS=5
ELLA_FPS=16
ELLA_MAX_RESOLUTION=720p
ELLA_SUPPORTS_IMAGE_TO_VIDEO=true
COMFYUI_JOB_TIMEOUT_SECONDS=1800
MAX_OUTPUT_BYTES=262144000

# Persistent directory; mount this path as a durable volume in production.
ELLA_DATA_DIR=/data
